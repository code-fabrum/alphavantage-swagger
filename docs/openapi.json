  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "apikey",
        "description": "API key used to authenticate requests."
      }
    },
    "parameters": {
      "functionDaily": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "TIME_SERIES_DAILY"
          ],
          "default": "TIME_SERIES_DAILY"
        }
      },
      "functionIntraday": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The intraday function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "TIME_SERIES_INTRADAY"
          ],
          "default": "TIME_SERIES_INTRADAY"
        }
      },
      "functionWeekly": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "TIME_SERIES_WEEKLY"
          ],
          "default": "TIME_SERIES_WEEKLY"
        }
      },
      "functionMonthly": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "TIME_SERIES_MONTHLY"
          ],
          "default": "TIME_SERIES_MONTHLY"
        }
      },
      "functionSma": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "SMA"
          ],
          "default": "SMA"
        }
      },
      "functionEma": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "EMA"
          ],
          "default": "EMA"
        }
      },
      "functionRsi": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "RSI"
          ],
          "default": "RSI"
        }
      },
      "functionMacd": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "MACD"
          ],
          "default": "MACD"
        }
      },
      "functionOverview": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "OVERVIEW"
          ],
          "default": "OVERVIEW"
        }
      },
      "functionEarnings": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "EARNINGS"
          ],
          "default": "EARNINGS"
        }
      },
      "functionNewsSentiment": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "NEWS_SENTIMENT"
          ],
          "default": "NEWS_SENTIMENT"
        }
      },
      "functionTopMovers": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "TOP_GAINERS_LOSERS"
          ],
          "default": "TOP_GAINERS_LOSERS"
        }
      },
      "functionSector": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "SECTOR"
          ],
          "default": "SECTOR"
        }
      },
      "functionMarketStatus": {
        "name": "function",
        "in": "query",
        "required": true,
        "description": "The function to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "MARKET_STATUS"
          ],
          "default": "MARKET_STATUS"
        }
      },
      "symbol": {
        "name": "symbol",
        "in": "query",
        "required": true,
        "description": "Stock symbol to query, for example SPY, AAPL, MSFT, or NVDA.",
        "schema": {
          "type": "string"
        }
      },
      "outputsize": {
        "name": "outputsize",
        "in": "query",
        "description": "Output size for daily data. Compact returns the latest 100 points; full returns the full-length time series.",
        "schema": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ],
          "default": "compact"
        }
      },
      "interval": {
        "name": "interval",
        "in": "query",
        "description": "The time interval for intraday or technical indicator data.",
        "schema": {
          "type": "string",
          "enum": [
            "1min",
            "5min",
            "15min",
            "30min",
            "60min",
            "daily",
            "weekly",
            "monthly"
          ]
        }
      },
      "adjusted": {
        "name": "adjusted",
        "in": "query",
        "description": "Whether to return adjusted pricing data.",
        "schema": {
          "type": "boolean",
          "default": true
        }
      },
      "extended_hours": {
        "name": "extended_hours",
        "in": "query",
        "description": "Whether to include extended-hours trading sessions.",
        "schema": {
          "type": "boolean",
          "default": true
        }
      },
      "month": {
        "name": "month",
        "in": "query",
        "description": "Intraday month filter in YYYY-MM format.",
        "schema": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        }
      },
      "time_period": {
        "name": "time_period",
        "in": "query",
        "required": true,
        "description": "Number of data points used to calculate the technical indicator.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        }
      },
      "series_type": {
        "name": "series_type",
        "in": "query",
        "description": "The type of price series used to calculate the indicator.",
        "schema": {
          "type": "string",
          "enum": [
            "close",
            "open",
            "high",
            "low"
          ],
          "default": "close"
        }
      },
      "tickers": {
        "name": "tickers",
        "in": "query",
        "required": true,
        "description": "Comma-separated stock tickers to include in news sentiment filtering.",
        "schema": {
          "type": "string"
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of news items to return.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 10
        }
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "description": "Sort order for returned news items.",
        "schema": {
          "type": "string",
          "enum": [
            "RELEVANCE",
            "LATEST",
            "TOPIC"
          ],
          "default": "RELEVANCE"
        }
      },
      "apikey": {
        "name": "apikey",
        "in": "query",
        "required": true,
        "description": "Your Alpha Vantage API key.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "StockPrice": {
        "type": "object",
        "description": "A single stock price observation for a timestamp.",
        "properties": {
          "open": {
            "type": "string"
          },
          "high": {
            "type": "string"
          },
          "low": {
            "type": "string"
          },
          "close": {
            "type": "string"
          },
          "volume": {
            "type": "string"
          }
        },
        "required": [
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      },
      "TechnicalIndicator": {
        "type": "object",
        "description": "A single technical indicator value for a timestamp.",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ]
      },
      "CompanyOverview": {
        "type": "object",
        "description": "Company overview and fundamental metrics for a stock symbol.",
        "properties": {
          "Symbol": {
            "type": "string"
