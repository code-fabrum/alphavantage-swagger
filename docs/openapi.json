  "paths": {
    "/query/daily": {
      "get": {
        "summary": "Daily Time Series",
        "description": "Returns daily open, high, low, close, and volume data for the specified stock symbol.",
        "operationId": "getDailyTimeSeries",
        "tags": [
          "Time Series"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/functionDaily"
          },
          {
            "$ref": "#/components/parameters/symbol"
          },
          {
            "$ref": "#/components/parameters/outputsize"
          },
          {
            "$ref": "#/components/parameters/apikey"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/DailyTimeSeriesResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "x-ms-connector-name": "AlphaVantageDailyTimeSeries"
      }
    },
